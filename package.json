{
  "name": "agent-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Local macOS Agent Deck: AI agent usage, Mac metrics, and GitHub contributions",
  "license": "MIT",
  "author": "ctt062",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctt062/agent-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/ctt062/agent-dashboard/issues"
  },
  "homepage": "https://github.com/ctt062/agent-dashboard#readme",
  "keywords": [
    "dashboard",
    "cursor",
    "claude-code",
    "codex",
    "macos",
    "localhost",
    "github-contributions"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray.bold,white.bold \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
